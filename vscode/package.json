{
	"name": "theme-hbuilderx-soft-green-light",
	"displayName": "%displayName%",
	"description": "%description%",
	"version": "1.1.2",
	"homepage": "https://github.com/qinains/hbuilderx-soft-green/blob/main/README.md",
	"repository": {
		"type": "git",
		"url": "https://github.com/qinains/hbuilderx-soft-green"
	},
	"bugs": {
		"url": "https://github.com/qinains/hbuilderx-soft-green/issues"
	},
	"publisher": "lninl",
	"license": "MIT",
	"icon": "icon.png",
	"engines": {
		"vscode": "^1.89.0"
	},
	"categories": [
		"Themes",
		"Other"
	],
	"keywords": [
		"health",
		"hbuilder",
		"hbuilderx",
		"soft green",
		"green soft",
		"h5builder",
		"green",
		"yellow",
		"solarized",
		"light",
		"dark",
		"auto-switch"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./dist/extension.js",
	"scripts": {
		"test": "tsx --test tests/**/*.test.ts",
		"test:zed": "node ../tests/zed-theme.test.js",
		"vscode:prepublish": "webpack --mode production",
		"compile": "webpack --mode development",
		"watch": "webpack --mode development --watch",
		"build": "npm run compile",
		"package": "vsce package"
	},
	"devDependencies": {
		"@types/node": "^20.19.43",
		"@types/vscode": "1.89.0",
		"@vscode/vsce": "^3.9.2",
		"jsonc-parser": "^3.3.1",
		"ts-loader": "^9.6.2",
		"tsx": "^4.23.13",
		"typescript": "^5.0.0",
		"webpack": "^5.110.2",
		"webpack-cli": "^5.0.0"
	},
	"contributes": {
		"themes": [
			{
				"label": "HBuilderX Soft Green Light",
				"uiTheme": "vs",
				"path": "./themes/hbuilderx-soft-green-light-color-theme.json"
			},
			{
				"id": "hbuilderx-soft-green-dark",
				"label": "HBuilderX Soft Green Dark",
				"uiTheme": "vs-dark",
				"path": "./themes/hbuilderx-soft-green-dark-color-theme.json"
			}
		],
		"configuration": {
			"title": "HBuilderX Soft Green Theme",
			"properties": {
				"hbuilderxSoftGreen.autoSwitchMode": {
					"type": "string",
					"enum": [
						"system",
						"scheduled",
						"seasonal",
						"manual"
					],
					"enumDescriptions": [
						"Leave system theme switching to your existing editor settings (does not configure them)",
						"Opt in to switching at scheduled times; pauses while native auto-detection is enabled",
						"Opt in to seasonal switching (approx sunrise/sunset); pauses while native auto-detection is enabled",
						"No automatic changes; select or toggle a theme yourself"
					],
					"default": "manual",
					"description": "Optional dark/light theme switching. Never changes native auto-detection or preferred light/dark themes."
				},
				"hbuilderxSoftGreen.lightTime": {
					"type": "string",
					"default": "07:00",
					"pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$",
					"description": "Time to switch to light theme (HH:MM, scheduled mode)"
				},
				"hbuilderxSoftGreen.darkTime": {
					"type": "string",
					"default": "19:00",
					"pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$",
					"description": "Time to switch to dark theme (HH:MM, scheduled mode)"
				}
			}
		},
		"commands": [
			{
				"command": "hbuilderxSoftGreen.toggleTheme",
				"title": "Toggle Theme (Light/Dark)"
			},
			{
				"command": "hbuilderxSoftGreen.setModeSystem",
				"title": "HBuilderX Soft Green: Set Mode → Follow System"
			},
			{
				"command": "hbuilderxSoftGreen.setModeScheduled",
				"title": "HBuilderX Soft Green: Set Mode → Scheduled Times"
			},
			{
				"command": "hbuilderxSoftGreen.setModeSeasonal",
				"title": "HBuilderX Soft Green: Set Mode → Seasonal"
			},
			{
				"command": "hbuilderxSoftGreen.setModeManual",
				"title": "HBuilderX Soft Green: Set Mode → Manual"
			},
			{
				"command": "hbuilderxSoftGreen.setLightTime",
				"title": "HBuilderX Soft Green: Set Light Theme Time"
			},
			{
				"command": "hbuilderxSoftGreen.setDarkTime",
				"title": "HBuilderX Soft Green: Set Dark Theme Time"
			}
		]
	}
}
